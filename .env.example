# Agent Gateway - Configurações de Ambiente
# Copie este arquivo para .env e preencha com as suas próprias chaves de API.

# OpenAI API Key (necessária para usar agentes como Data Analyst - GPT)
OPENAI_API_KEY=sk-proj-sua-chave-aqui

# Anthropic API Key (necessária para usar agentes como SysOps - Claude)
ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui

# Google Gemini API Key (necessária para usar agentes como Researcher - Gemini)
GOOGLE_API_KEY=AIzaSy-sua-chave-aqui

# Configurações do Servidor (opcional)
# PORT=3000
