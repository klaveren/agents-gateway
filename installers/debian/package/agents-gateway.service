[Unit]
Description=Agents Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agents-gateway
Group=agents-gateway
# O processo roda de dentro do app, não da pasta de dados: o cerco dos agentes nega ler a pasta do processo.
WorkingDirectory=/opt/agents-gateway/app
Environment=HOME=/var/lib/agents-gateway
Environment=PATH=/opt/agents-gateway/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=CERCO_READ_ALLOWLIST=1
EnvironmentFile=/etc/agents-gateway/settings.env
EnvironmentFile=/etc/agents-gateway/gateway.env
ExecStart=/opt/agents-gateway/bin/node /opt/agents-gateway/app/dist/main.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
