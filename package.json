{
  "name": "agents-gateway",
  "version": "1.0.0-alpha",
  "description": "Gateway that runs Claude, GPT and Gemini in two lanes: chat (plain SDK) and agent (official Agents SDK).",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "build": "tsc && tsc-alias",
    "build:web": "pnpm --dir web install --frozen-lockfile && pnpm --dir web build",
    "dev:web": "pnpm --dir web dev",
    "test:web": "pnpm --dir web test",
    "test": "CONVERSATIONS_DB=:memory: node --test --import tsx 'src/**/*.test.ts'",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.309",
    "@anthropic-ai/sandbox-runtime": "0.0.79",
    "@anthropic-ai/sdk": "^0.117.1",
    "@google/adk": "^1.6.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openai/agents": "^0.16.1",
    "@openai/codex": "0.163.0",
    "@openai/codex-sdk": "0.163.0",
    "@types/express": "^5.0.6",
    "@xterm/headless": "6.0.0",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "openai": "^7.4.0",
    "tree-sitter-bash": "^0.25.1",
    "web-tree-sitter": "^0.27.1",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "overrides": {
      "proxy-addr": ">=2.0.8",
      "tar": ">=7.5.21",
      "fast-uri": ">=3.1.7",
      "adm-zip": ">=0.6.1",
      "follow-redirects": ">=1.16.1",
      "js-yaml": ">=4.3.2",
      "undici": ">=7.29.1",
      "@grpc/grpc-js": ">=1.14.5",
      "@modelcontextprotocol/client": "^2.2.0",
      "http-cache-semantics": ">=4.3.0",
      "mariadb": ">=3.4.7",
      "mysql2": ">=3.22.0",
      "brace-expansion@<2": "^1.1.21",
      "brace-expansion@>=4 <6": "^5.0.12"
    }
  }
}
